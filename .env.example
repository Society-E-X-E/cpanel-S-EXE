# Generate unique values before deploying. Never reuse sample values.
JWT_SECRET=

# Used only once to create the first Owner account when the staff database is empty.
OWNER_USERNAME=
OWNER_PASSWORD=
OWNER_EMAIL=

# Exact origin used to build OAuth callback URLs. Use the deployed dashboard origin in production.
APP_BASE_URL=http://localhost:3000

# Generate a unique random value of at least 32 characters for encrypting OAuth tokens.
OAUTH_TOKEN_ENCRYPTION_KEY=

# Cloudinary credentials for profile-photo uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OAuth app credentials. Configure callback URLs as:
# {APP_BASE_URL}/api/admin/oauth/{provider}
# Providers: github, gitlab, linkedin, google, x
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
